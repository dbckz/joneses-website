# Bandsintown public API credentials for gig data.
# Copy this file to `.env` and fill in the real values.
#
# When either value is missing, the build falls back to sample fixture data
# (build/fixtures/bandsintown-events.json) and the client skips live refresh.

# Numeric Bandsintown artist id (the digits in id_<...> from the artist page/API).
BANDSINTOWN_ARTIST_ID=your-artist-id-here

# Bandsintown app_id — an identifier you supply on every API request.
BANDSINTOWN_APP_ID=your-app-id-here
